+
+#ifdef TORRENT_WINDOWS
+unsigned int fero_interface_index(char const* name)
+{
+	// Libtorrent's Windows adapter names are braced GUIDs.
+	if (std::strlen(name) != 38) return 0;
+	wchar_t wide[39]{};
+	std::copy_n(name, 38, wide);
+	GUID guid{};
+	NET_LUID luid{};
+	NET_IFINDEX index{};
+	if (CLSIDFromString(wide, &guid) != S_OK
+		|| ConvertInterfaceGuidToLuid(&guid, &luid) != NO_ERROR
+		|| ConvertInterfaceLuidToIndex(&luid, &index) != NO_ERROR)
+		return 0;
+	return index;
+}
+#endif
 
