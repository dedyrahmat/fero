+
+#ifdef TORRENT_WINDOWS
+unsigned int fero_interface_index(char const* name);
+#endif
+
+// IPv4 and IPv6 use distinct socket options on Apple and Windows.
+#if defined(__APPLE__) || defined(TORRENT_WINDOWS)
+struct fero_interface_option
+{
+	unsigned int index;
+	bool ipv6;
+	template<class Protocol>
+	int level(Protocol const&) const { return ipv6 ? IPPROTO_IPV6 : IPPROTO_IP; }
+	template<class Protocol>
+	int name(Protocol const&) const
+	{
+#ifdef TORRENT_WINDOWS
+		return ipv6 ? IPV6_UNICAST_IF : IP_UNICAST_IF;
+#else
+		return ipv6 ? IPV6_BOUND_IF : IP_BOUND_IF;
+#endif
+	}
+	template<class Protocol>
+	char const* data(Protocol const&) const { return reinterpret_cast<char const*>(&index); }
+	template<class Protocol>
+	size_t size(Protocol const&) const { return sizeof(index); }
+};
+#endif
+
+template <typename Socket>
+void fero_bind_interface(Socket& socket, char const* name, bool ipv6, error_code& ec)
+{
+	if (!name || !*name)
+	{
+		ec = make_error_code(boost::system::errc::no_such_device);
+		return;
+	}
+#if defined(TORRENT_WINDOWS)
+	unsigned int const index = fero_interface_index(name);
+	if (index == 0)
+	{
+		ec = make_error_code(boost::system::errc::no_such_device);
+		return;
+	}
+	socket.set_option(fero_interface_option{ipv6 ? index : htonl(index), ipv6}, ec);
+#elif defined(__APPLE__)
+	unsigned int const index = if_nametoindex(name);
+	if (index == 0)
+	{
+		ec = make_error_code(boost::system::errc::no_such_device);
+		return;
+	}
+	socket.set_option(fero_interface_option{index, ipv6}, ec);
+#elif defined(SO_BINDTODEVICE)
+	(void)ipv6;
+	bind_device(socket, name, ec);
+#else
+	(void)socket;
+	(void)ipv6;
+	ec = make_error_code(boost::system::errc::not_supported);
+#endif
+}
 
 } }
 
