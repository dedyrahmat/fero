+
+namespace libtorrent {
+void fero_fetch_feed(session_handle const& session, std::string url, fero_feed_handler handler)
+{
+	auto impl = session.native_handle();
+	if (!impl)
+	{
+		handler("The transfer session is unavailable", {});
+		return;
+	}
+	auto& context = impl->get_context();
+	post(context, [impl = std::move(impl), url = std::move(url), handler = std::move(handler)]() mutable {
+		impl->fetch_fero_feed(std::move(url), std::move(handler));
+	});
