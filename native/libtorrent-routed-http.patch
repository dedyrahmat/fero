+	void session_impl::fetch_fero_feed(std::string url, fero_feed_handler handler)
+	{
+		if (m_paused || m_abort)
+		{
+			handler("The network route is unavailable", {});
+			return;
+		}
+		bool const strict_interface = m_settings.get_bool(settings_pack::fero_strict_interface);
+		auto open = [this, url, handler = std::move(handler), strict_interface](
+			error_code const& lookup_error, std::vector<address> const& addresses) mutable {
+			if (m_paused || m_abort)
+			{
+				handler("The network route is unavailable", {});
+				return;
+			}
+			if (lookup_error)
+			{
+				handler(lookup_error.message(), {});
+				return;
+			}
+			std::optional<bind_info_t> outgoing;
+			if (strict_interface)
+			{
+				auto const routes = [&](auto const& socket) {
+					return std::any_of(addresses.begin(), addresses.end(),
+						[&](address const& ip) { return socket->can_route(ip); });
+				};
+				auto selected = std::find_if(m_listen_sockets.begin(), m_listen_sockets.end(), routes);
+				if (selected == m_listen_sockets.end())
+				{
+					handler("The selected VPN interface cannot route to this feed", {});
+					return;
+				}
+				outgoing = bind_info_t{(*selected)->device,
+					(*selected)->local_endpoint.address(), true};
+			}
+			auto const callback = [complete = std::move(handler)](error_code const& error,
+				http_parser const& parser, span<char const> body, http_connection&) mutable {
+				if (!complete) return;
+				auto done = std::move(complete);
+				bool const closed_body = error == boost::asio::error::eof && parser.header_finished()
+					&& parser.content_length() < 0 && !parser.chunked_encoding();
+				if (error && !closed_body) done(error.message(), {});
+				else if (parser.status_code() < 200 || parser.status_code() >= 300)
+					done("Feed returned HTTP " + std::to_string(parser.status_code()), {});
+				else done({}, std::vector<char>(body.begin(), body.end()));
+			};
+			auto connection = std::make_shared<http_connection>(m_io_context, m_host_resolver,
+				callback, 4 * 1024 * 1024, http_connect_handler{}, http_filter_handler{},
+				hostname_filter_handler{}
+#if TORRENT_USE_SSL
+				, &m_ssl_ctx
+#endif
+				);
+			auto const configured_proxy = proxy();
+			connection->get(url, seconds(15), &configured_proxy, 5,
+				m_settings.get_str(settings_pack::user_agent), outgoing,
+				resolver_interface::abort_on_shutdown);
+		};
+		if (!strict_interface)
+		{
+			open({}, {});
+			return;
+		}
+		error_code error;
+		auto const parts = parse_url_components(url, error);
+		if (error) open(error, {});
+		else m_host_resolver.async_resolve(std::get<2>(parts), resolver_interface::abort_on_shutdown,
+			std::move(open));
+	}
