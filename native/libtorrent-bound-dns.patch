+			return;
+		if (ares_set_servers_csv(channel, server.c_str()) != ARES_SUCCESS)
+		{
+			ares_destroy(channel);
+			channel = nullptr;
+			return;
+		}
+		ares_set_socket_configure_callback(channel, [](ares_socket_t fd, int, void* context) {
+			auto const& self = *static_cast<scoped_dns*>(context);
+			native_socket socket{fd};
+			error_code error;
+			fero_bind_interface(socket, self.adapter_name.c_str(), self.ipv6, error);
+			return error ? -1 : 0;
+		}, this);
+	}
+
+	~scoped_dns() { if (channel) ares_destroy(channel); }
+
+	void resolve(std::string const& host, resolver_interface::callback_t handler)
+	{
+		if (!channel || stopped)
+		{
+			handler(stopped ? error_code(boost::asio::error::operation_aborted)
+				: error_code(boost::asio::error::host_not_found), {});
+			return;
+		}
+		auto pending_request = std::make_unique<query>(query{*this, std::move(handler)});
+		++pending;
+		ares_addrinfo_hints hints{};
+		hints.ai_family = AF_UNSPEC;
+		hints.ai_flags = ARES_AI_NOSORT;
+		ares_getaddrinfo(channel, host.c_str(), nullptr, &hints,
+			[](void* arg, int status, int, ares_addrinfo* result) {
+				std::unique_ptr<query> request(static_cast<query*>(arg));
+				std::vector<address> addresses;
+				if (status == ARES_SUCCESS && result)
+				{
+					for (auto node = result->nodes; node; node = node->ai_next)
+						{
+						if (node->ai_family == AF_INET && node->ai_addrlen >= sizeof(sockaddr_in))
+						{
+							address_v4::bytes_type bytes{};
+							auto const* addr = reinterpret_cast<sockaddr_in const*>(node->ai_addr);
+							std::memcpy(bytes.data(), &addr->sin_addr, bytes.size());
+							addresses.emplace_back(address_v4(bytes));
+						}
+						else if (node->ai_family == AF_INET6 && node->ai_addrlen >= sizeof(sockaddr_in6))
+						{
+							address_v6::bytes_type bytes{};
+							auto const* addr = reinterpret_cast<sockaddr_in6 const*>(node->ai_addr);
+							std::memcpy(bytes.data(), &addr->sin6_addr, bytes.size());
+							addresses.emplace_back(address_v6(bytes, addr->sin6_scope_id));
+						}
+					}
+				}
+				if (result) ares_freeaddrinfo(result);
+				--request->owner.pending;
+				error_code error;
+				if (status == ARES_ECANCELLED || status == ARES_EDESTRUCTION)
+					error = boost::asio::error::operation_aborted;
+				else if (addresses.empty())
+					error = boost::asio::error::host_not_found;
+				post(request->owner.timer.get_executor(),
+					[complete = std::move(request->handler), error, result_addresses = std::move(addresses)] {
+						complete(error, result_addresses);
+					});
+			}, pending_request.release());
+		tick();
+	}
+
+	void abort()
+	{
+		stopped = true;
+		if (channel) ares_cancel(channel);
+	}
+
+private:
+	struct native_socket
+	{
+		ares_socket_t fd;
+
+		template <typename Option>
+		void set_option(Option const& option, error_code& error)
+		{
+			auto const protocol = tcp::v4();
+			if (::setsockopt(fd, option.level(protocol), option.name(protocol),
+				option.data(protocol), static_cast<ares_socklen_t>(option.size(protocol))) != 0)
+				error = error_code(last_socket_error(), system_category());
+		}
+
+		static int last_socket_error()
+		{
+#ifdef TORRENT_WINDOWS
+			return WSAGetLastError();
+#else
+			return errno;
+#endif
+		}
+	};
+
+	struct query
+	{
+		scoped_dns& owner;
+		resolver_interface::callback_t handler;
+	};
+
+	void tick()
+	{
+		if (pending == 0 || ticking) return;
+		ticking = true;
+		timer.expires_after(std::chrono::milliseconds(20));
+		timer.async_wait([weak = weak_from_this()](error_code const& ec) {
+			auto self = weak.lock();
+			if (!self || ec) return;
+			self->ticking = false;
+			std::vector<pollfd> descriptors;
+			for (auto const& entry : self->sockets)
+				descriptors.push_back({entry.first, entry.second, 0});
+
+			std::vector<ares_fd_events_t> events;
+			if (!descriptors.empty())
+			{
+#ifdef TORRENT_WINDOWS
+				WSAPoll(descriptors.data(), static_cast<ULONG>(descriptors.size()), 0);
+#else
+				::poll(descriptors.data(), static_cast<nfds_t>(descriptors.size()), 0);
+#endif
+				for (auto const& descriptor : descriptors)
+				{
+					unsigned int flags = 0;
+					if (descriptor.revents & (POLLIN | POLLERR | POLLHUP | POLLNVAL))
+						flags |= ARES_FD_EVENT_READ;
+					if (descriptor.revents & POLLOUT) flags |= ARES_FD_EVENT_WRITE;
+					if (flags) events.push_back({descriptor.fd, flags});
+				}
+			}
+			ares_process_fds(self->channel, events.data(), events.size(), ARES_PROCESS_FLAG_NONE);
+			self->tick();
+		});
+	}
+
+	boost::asio::steady_timer timer;
+	std::string adapter_name;
+	std::map<ares_socket_t, short> sockets;
+	ares_channel_t* channel = nullptr;
+	int pending = 0;
+	bool ipv6 = false;
+	bool stopped = false;
+	bool ticking = false;
+};
 
