+		ares_options options{};
+		options.flags = ARES_FLAG_NOSEARCH;
+		char lookups[] = "b";
+		options.lookups = lookups;
+		options.timeout = 1000;
+		options.tries = 2;
+		options.sock_state_cb_data = this;
+		options.sock_state_cb = [](void* context, ares_socket_t fd, int read, int write) {
+			auto& monitored = static_cast<scoped_dns*>(context)->sockets;
+			short const events = (read ? POLLIN : 0) | (write ? POLLOUT : 0);
+			if (events) monitored[fd] = events;
+			else monitored.erase(fd);
+		};
