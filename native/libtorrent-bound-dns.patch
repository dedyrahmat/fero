+// Poll the single configured c-ares channel on the libtorrent session executor.
+struct scoped_dns : std::enable_shared_from_this<scoped_dns>
+{
+	scoped_dns(io_context& io, std::string device, std::string const& server)
+		: timer(io), adapter_name(std::move(device))
+	{
+		error_code ec;
